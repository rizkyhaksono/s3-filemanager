# Optional: password for logging into the file manager.
# If empty, the app is open to anyone who can reach it — set this when deploying.
ADMIN_PASSWORD=

# Optional: secret used to encrypt S3 credentials in SQLite and sign sessions.
# If empty, one is generated automatically and stored in data/.secret
APP_SECRET=

# Optional: SQLite database location (default: ./data/app.db)
DATABASE_PATH=

# Optional: connect straight to one S3-compatible bucket.
# If both keys are set, the app opens that storage and skips the connection list.
# Leave them empty to use saved connections instead.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
# true for MinIO, R2, and most S3-compatible providers. false for Amazon S3 virtual-hosted.
S3_FORCE_PATH_STYLE=true
S3_NAME=
